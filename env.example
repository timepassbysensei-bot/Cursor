# ---------------------------------------------------------------------------
# Arian — creator platform environment variables
#
# In this workspace the tool guard protects files literally named `.env*`, so
# this template ships as `env.example`. Copy it to `.env.local` yourself, or
# paste the same keys into your host's environment settings:
#
#   cp env.example .env.local
#
# Netlify → Site configuration → Environment variables accepts the same names.
# ---------------------------------------------------------------------------

# --- Browser-safe (Vite exposes anything prefixed with VITE_) --------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical site origin, used for auth redirect links and share metadata.
VITE_SITE_URL=http://localhost:5173

# Arian's YouTube channel. Change this once and every "Watch on YouTube" call
# to action on the site follows it.
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@youknowArian

# Where the browser posts chat messages. Netlify redirects /api/* to the
# functions directory, so this only changes for local `netlify dev` work.
VITE_CHAT_ENDPOINT=/api/chat

# --- Server-side only (Netlify Functions). NEVER prefix these with VITE_ ---

# Same Supabase project as above, plus the service-role key. This lets the
# chat function read Arian's approved knowledge base and lets the
# account-deletion function remove an auth user. Neither action is possible
# from the browser with these values absent — by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key. Read only inside netlify/functions/chat.mjs.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Optional: how many chat questions one IP may ask per minute (default 12).
CHAT_RATE_LIMIT_PER_MINUTE=12
